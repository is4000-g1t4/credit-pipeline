ADMIN_DATABASE_URL=postgres://credit:credit@localhost:5432/postgres
AUTH_DATABASE_URL=postgres://credit:credit@localhost:5432/credit_auth
APPLICATIONS_DATABASE_URL=postgres://credit:credit@localhost:5432/credit_applications
LOANS_DATABASE_URL=postgres://credit:credit@localhost:5432/credit_loans
PORTFOLIO_DATABASE_URL=postgres://credit:credit@localhost:5432/credit_portfolio
TEMPORAL_ADDRESS=localhost:7233
KAFKA_BROKERS=localhost:9092
SESSION_SECRET=change-me-generate-a-32-byte-hex-secret
INTERNAL_SECRET=change-me-generate-a-32-byte-hex-secret
# Gateway → service base URLs (defaults match local `pnpm dev` ports;
# compose.services.yml overrides these for container networking).
APPLICATIONS_URL=http://127.0.0.1:4001
REVIEW_URL=http://127.0.0.1:4002
LOANS_URL=http://127.0.0.1:4003
PORTFOLIO_URL=http://127.0.0.1:4004
API_PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
VITE_API_URL=/api
DEMO_MODE=true
NODE_ENV=development
# Phase 2 agentic research (advisory; off unless both flags are on).
# RESEARCH_DATABASE_URL is optional: the research service defaults to the
# local credit_research DB when unset (db:migrate still skips it then).
# Placeholder values only — real keys live in the untracked root .env.
RESEARCH_DATABASE_URL=postgres://credit:credit@localhost:5432/credit_research
RESEARCH_URL=http://127.0.0.1:4005
# EN-01/02/03 case assist (evidence bundle, generated artifacts, shared
# generator validator). Off by default: every assist route 404s while false.
ASSIST_ENABLED=false
ASSIST_RETENTION_DAYS=90
ASSIST_RESEARCH_TIMEOUT_MS=5000
ASSIST_MODEL=deterministic
ASSIST_PROMPT_VERSION=memo-template-v1
# Agentic credit-memo writer (SPEC agentic-memo, wave B). deterministic keeps
# the template builder; agent runs the bounded OpenRouter tool loop and fails
# closed (503) when OPENROUTER_API_KEY is unset.
ASSIST_MEMO_WRITER=deterministic
ASSIST_MEMO_MODEL=deepseek/deepseek-v4.1-flash-1017
ASSIST_MEMO_PROMPT_VERSION=memo-agent-v1
ASSIST_MEMO_AGENT_VERSION=memo-agent-v1
ASSIST_MEMO_MAX_STEPS=8
ASSIST_MEMO_MAX_TOOL_CALLS=12
ASSIST_MEMO_TIMEOUT_MS=45000
ASSIST_MEMO_MAX_COST_USD=0.25
ASSIST_MEMO_MAX_OUTPUT_TOKENS=4000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ASSIST_ADVERSE_JURISDICTION=SG
# Required for a legal notice; leave blank to fail closed (422) until set.
ASSIST_ADVERSE_CONTACT_PATH=
ASSIST_ADVERSE_PROMPT_VERSION=adverse-letter-v1
AGENTS_ENABLED=false
AGENT_CASE_BRIEF_ENABLED=false
AGENT_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_API_KEY=
TAVILY_API_KEY=
AGENT_MAX_SOURCES=6
AGENT_MAX_FETCHES=4
AGENT_TIMEOUT_MS=90000
AGENT_TEMPERATURE=0.1
AGENT_MAX_OUTPUT_TOKENS=3000
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_TURNS=12
AGENT_MAX_COST_USD=2.0
# T18 context analyst (separate stage inside T11). Off by default; the stage
# never runs without it. CONTEXT_AGENT_MODEL defaults to AGENT_MODEL. When on,
# the analyst starts from a bounded officer-screen snapshot (preflight) then
# drills in via a read-only tool loop (customer, accounts, transactions,
# metrics, financials, documents, credit history, external reports, KYC
# checks, loans) — the preflight is bounded, the model loop is not a fixed
# snapshot. CONTEXT_AGENT_MAX_TOOL_CALLS counts model tool invocations;
# CONTEXT_AGENT_PREFLIGHT_TOOL_CALLS counts preflight HTTP calls (model HTTP
# rides a generous backstop, never the preflight pool).
CONTEXT_ANALYST_ENABLED=false
# CONTEXT_AGENT_MODEL=deepseek/deepseek-v4.1-flash-1017
CONTEXT_AGENT_MAX_TOOL_CALLS=16
CONTEXT_AGENT_PREFLIGHT_TOOL_CALLS=16
CONTEXT_AGENT_MAX_TURNS=16
CONTEXT_AGENT_TEMPERATURE=0.1
CONTEXT_AGENT_MAX_OUTPUT_TOKENS=6000
CONTEXT_AGENT_TIMEOUT_MS=180000
CONTEXT_AGENT_MAX_COST_USD=1.5
CONTEXT_HISTORY_MONTHS=6
# T11 auto-trigger on referral (research consumes credit.review.requested).
# Off by default; the consumer never starts until AGENT_AUTO_TRIGGER_ENABLED
# is true. Service principal + caps/budget guard paid work.
AGENT_AUTO_TRIGGER_ENABLED=false
AGENT_AUTO_TRIGGER_FROM_BEGINNING=false
AUTO_TRIGGER_SERVICE_USER_ID=00000000-0000-0000-0000-000000000000
AUTO_TRIGGER_SERVICE_EMAIL=research-auto@internal.local
AUTO_TRIGGER_MAX_RUNS_PER_APPLICANT_DAY=2
AUTO_TRIGGER_MAX_RUNS_PER_DAY=50
AUTO_TRIGGER_DAILY_COST_BUDGET_USD=10
AGENTO11Y_ENDPOINT=
AGENTO11Y_PROTOCOL=
AGENTO11Y_AUTH_MODE=
AGENTO11Y_AUTH_TENANT_ID=
AGENTO11Y_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# T01 document workflow (SPEC-t01-t02 §10). Off by default until D1 lands.
# Placeholder values only — the real encryption key lives in the untracked
# root .env (blank below on purpose).
DOCUMENT_FEATURE_ENABLED=false
DOCUMENT_STORAGE_DIR=.data/documents
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_KEY_ID=v1
DOCUMENT_PREVIOUS_KEYS=
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_MAX_PAGES=20
DOCUMENT_MAX_PAGE_TEXT_BYTES=262144
DOCUMENT_MAX_TOTAL_TEXT_BYTES=2097152
DOCUMENT_MAX_PIXELS=16000000
DOCUMENT_UPLOAD_DEADLINE_MS=35000
DOCUMENT_LOCK_TIMEOUT_MS=5000
DOCUMENT_SCAN_TIMEOUT_MS=10000
DOCUMENT_OCR_TIMEOUT_MS=20000
DOCUMENT_OCR_CONCURRENCY=2
DOCUMENT_UPLOAD_RATE_PER_MIN=5
DOCUMENT_OCR_DATA_DIR=
# Blank uses apps/applications/assets/tesseract (vendored eng.traineddata.gz).
DOCUMENT_RETENTION_DAYS=90
DOCUMENT_SCANNER=clamd
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
DOCUMENT_CROSSCHECK_MIN_CONFIDENCE=0.7
DOCUMENT_UPLOAD_MAX_BYTES=11000000
# T17 customer evidence + intake (SPEC-t17-t18 §2/§5). The customer blob root
# is disjoint from DOCUMENT_STORAGE_DIR so the T01 app orphan sweep can
# never touch it. DEMO_AS_OF is the fixed fixture clock (D2 manifest owns
# the canonical value).
CUSTOMER_STORAGE_DIR=.data/customer-documents
CUSTOMER_RETENTION_DAYS=90
# T18 purge callback: on context-consent withdrawal the applications service
# POSTs RESEARCH_URL/internal/research/applications/:id/context/purge
# (service HMAC, best-effort). Unset disables the callback.
DEMO_AS_OF=2026-06-30
# D2a demo fixtures/reset (SPEC-t17-t18 §2.5). DEMO_SEED_VERSION must match
# fixtures/demo/manifest.json or demo:seed refuses. DEMO_RESET_ALLOWED gates
# the destructive demo:reset (also needs DEMO_MODE, non-production NODE_ENV,
# an explicit --yes, and a demo:seed sentinel); boot refuses it in prod.
DEMO_SEED_VERSION=1
DEMO_RESET_ALLOWED=false
# T03/T04 credit policy corpus + navigator (SPEC-t03-t04 §10). Own database
# (pgvector image in docker-compose.yml, one schema/config per service).
# Placeholder values only — secrets live in the untracked root .env
# (blank below on purpose). Set POLICY_ASSIST_ENABLED=true to turn on the
# navigator and automatic case review after the corpus is seeded.
POLICY_DATABASE_URL=postgres://credit:credit@localhost:5432/credit_policy
POLICY_URL=http://127.0.0.1:4006
POLICY_AGENT_MODEL=deepseek/deepseek-v4.1-flash-1017
POLICY_AGENT_TEMPERATURE=0
POLICY_AGENT_MAX_OUTPUT_TOKENS=6000
POLICY_AGENT_TIMEOUT_MS=60000
POLICY_CASE_TIMEOUT_MS=45000
POLICY_AGENT_MAX_COST_USD=0.10
POLICY_CASE_MAX_COST_USD=0.20
POLICY_NAV_DAILY_BUDGET_USD=2.0
POLICY_CASE_DAILY_BUDGET_USD=2.0
POLICY_ACTOR_DAILY_BUDGET_USD=1.0
POLICY_RESERVATION_TTL_SECONDS=180
POLICY_ASK_RATE_PER_MIN=10
POLICY_UPSTREAM_TIMEOUT_MS=75000
POLICY_AUDIT_HASH_SECRET=
POLICY_CASE_TOKEN_SECRET=
POLICY_CASE_TOKEN_TTL_SECONDS=120
POLICY_INTERNAL_SECRET=
POLICY_CITATION_SECRET=
POLICY_EMBEDDING_MODEL=voyageai/voyage-4-large
POLICY_EMBEDDING_DIMENSIONS=1024
POLICY_EMBEDDING_PROVIDERS=
POLICY_ANSWERER_PROVIDER_ORDER=
POLICY_RETRIEVAL_TOP_K=8
POLICY_JURISDICTION=SG
POLICY_EDITOR_PRINCIPAL=service:policy_editor
POLICY_ASSIST_ENABLED=false
