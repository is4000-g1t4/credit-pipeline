{
	"name": "@credit/policy",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch --env-file=../../.env src/server.ts",
		"typecheck": "tsc --noEmit",
		"build": "tsc --noEmit",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"seed": "bun --env-file=../../.env scripts/policy-seed.ts",
		"import:draft": "bun --env-file=../../.env scripts/policy-import.ts",
		"eval:embedding": "tsx eval/embedding-eval.ts",
		"eval:answers": "tsx eval/answer-eval.ts"
	},
	"dependencies": {
		"@credit/agent-observability": "workspace:*",
		"@credit/core": "workspace:*",
		"@credit/db": "workspace:*",
		"@credit/service-kit": "workspace:*",
		"@t3-oss/env-core": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"postgres": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
