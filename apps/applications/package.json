{
	"name": "@credit/applications",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch --env-file=../../.env src/server.ts",
		"dev:agent-worker": "tsx --env-file=../../.env src/agent-worker.ts",
		"typecheck": "tsc --noEmit",
		"build": "tsc --noEmit",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"eval:assist": "tsx eval/assist-eval.ts",
		"eval:adverse": "tsx eval/adverse-eval.ts",
		"eval:memo-agent": "tsx eval/memo-agent-eval.ts",
		"eval:memo-live": "tsx eval/memo-live-eval.ts",
		"eval:integrity": "tsx eval/integrity-eval.ts",
		"eval:policy-exception": "tsx eval/policy-exception-eval.ts"
	},
	"dependencies": {
		"@credit/agent-kit": "workspace:*",
		"@credit/agent-observability": "workspace:*",
		"@credit/core": "workspace:*",
		"@credit/db": "workspace:*",
		"@credit/service-kit": "workspace:*",
		"@openai/agents": "catalog:",
		"@t3-oss/env-core": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"openai": "catalog:",
		"pdfjs-dist": "catalog:",
		"postgres": "catalog:",
		"tesseract.js": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
